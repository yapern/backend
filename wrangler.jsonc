{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yapern-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "vars": {
  },
  "send_email": [
    { "name": "MARKETING_EMAIL" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATIONS", "class_name": "UserNotifications" }]
  },
  "migrations": [
    { "tag": "v1-notifications", "new_sqlite_classes": ["UserNotifications"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delta",
      "database_id": "183b6e44-28a9-4ce8-a29e-f50933220622",
      "migrations_dir": "migrations",
      "migrations_table": "schema_migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "romeo"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "queues": {
    "producers": [
      {
        "binding": "PREVIEW_QUEUE",
        "queue": "yapern-previews"
      }
    ],
    "consumers": [
      {
        "queue": "yapern-previews",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 2
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "routes": [
    {
      "pattern": "api.yapern.com",
      "custom_domain": true
    }
  ]
}
