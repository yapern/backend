{
  "name": "foo-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test worker/app/*.test.ts worker/durable-objects/*.test.ts",
    "test:admin": "node --import tsx --test worker/app/admin.test.ts",
    "test:marketing": "node --import tsx --test worker/app/marketing-email.test.ts",
    "dev": "wrangler dev --local",
    "dev:lan": "wrangler dev --local --ip 0.0.0.0",
    "db:migrate:local": "wrangler d1 migrations apply delta --local",
    "db:migrate:remote": "wrangler d1 migrations apply delta --remote",
    "generate-types": "wrangler types",
    "type-check": "npm run generate-types && tsc --noEmit",
    "deploy": "CI=true wrangler d1 migrations apply delta --remote && wrangler deploy"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "fast-xml-parser": "^5.12.0",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  }
}
